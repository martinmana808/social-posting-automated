# --- Supabase (create a NEW project for this tool) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Token encryption (clients' Page tokens are encrypted at rest) ---
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Admin + cron ---
ADMIN_PASSWORD=
# Generate: openssl rand -hex 24
CRON_SECRET=

# --- Meta (only used by scripts/onboard-client.mjs, not the running app) ---
# Use a neutral, client-agnostic Meta app for this tool.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Misc ---
# Fallback timezone when a client row has none (each client sets its own).
DEFAULT_TIMEZONE=Pacific/Auckland
