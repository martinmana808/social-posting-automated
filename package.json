{
	"name": "social-posting-automated",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "F925 operator tool: schedules and publishes finished content to many clients' Facebook + Instagram, each client fully isolated.",
	"scripts": {
		"dev": "vite dev --port 5182",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@netlify/functions": "^3.0.0",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.3.0",
		"@types/ws": "^8.18.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.58.0",
		"csv-parse": "^6.1.0",
		"ws": "^8.21.0"
	}
}
